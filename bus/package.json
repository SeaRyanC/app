  },
  "dependencies": {
    "preact": "^10.28.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.27.0",
    "@types/node": "^25.0.3",
    "esbuild": "^0.27.2",
    "eslint": "^9.27.0",
    "typescript": "^6.0.0-dev.20260920",
    "typescript-eslint": "^8.32.1"
  }
}
